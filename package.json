{
  "name": "quixx",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/engine",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "test": "npm run test -ws --if-present",
    "dev:server": "npm run dev -w @quixx/server",
    "dev:client": "npm run dev -w @quixx/client",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
